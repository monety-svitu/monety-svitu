<!DOCTYPE html>
<html lang="uk"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Скарбниця Нумізмата v1</title>
<style>
body{font-family:Arial;max-width:900px;margin:auto;padding:15px;background:#f5f5f5}
.card{background:white;padding:15px;border-radius:12px;margin:10px 0}
.big{font-size:48px;font-weight:bold;text-align:center}
button,input{padding:10px;margin:4px}
input{width:100%;box-sizing:border-box}
</style></head><body>
<h1>🪙 Скарбниця Нумізмата v1</h1>
<div class="card">Монет відкрито: <span id="coins">0</span> | XP: <span id="xp">0</span> | Серія: <span id="streak">0</span></div>
<div class="card"><div id="year" class="big"></div><button onclick="newTask()">Нове число</button><button onclick="hideYear()">Сховати</button></div>
<div class="card"><input id="answer" placeholder="Введи рік"><button onclick="checkAns()">Перевірити</button><div id="result"></div></div>
<div class="card"><h3>Образи</h3><div id="images"></div></div>
<div class="card"><h3>Музей</h3><div id="museum"></div></div>
<script>
let stats=JSON.parse(localStorage.getItem('numi_stats')||'{"coins":0,"xp":0,"streak":0}');
let current='';
const imgs={'19':'банан','20':'велосипед','28':'павук','31':'дерево','35':'рукавиця','46':'ключ','47':'ракета','55':'руки','58':'наручники','67':'вудка','69':'інь-янь','77':'блискавки','88':'окуляри','99':'кульки'};
function render(){coins.textContent=stats.coins;xp.textContent=stats.xp;streak.textContent=stats.streak;}
function save(){localStorage.setItem('numi_stats',JSON.stringify(stats));render();}
function r2(){return String(Math.floor(Math.random()*100)).padStart(2,'0');}
function newTask(){current=r2()+r2();year.textContent=current;let a=current.slice(0,2),b=current.slice(2,4);images.innerHTML=a+' = '+(imgs[a]||('образ '+a))+'<br>'+b+' = '+(imgs[b]||('образ '+b));}
function hideYear(){year.textContent='????';}
function checkAns(){let v=answer.value.trim();if(v===current){stats.coins++;stats.xp+=10;stats.streak++;save();result.innerHTML='✅ Правильно';let m=JSON.parse(localStorage.getItem('museum')||'[]');m.push(current);localStorage.setItem('museum',JSON.stringify(m));showMuseum();newTask();}else{stats.streak=0;save();result.innerHTML='❌ Було '+current;}}
function showMuseum(){let m=JSON.parse(localStorage.getItem('museum')||'[]');museum.innerHTML=m.slice(-50).map(x=>'🪙 '+x).join('<br>');}
render();showMuseum();newTask();
</script></body></html>
